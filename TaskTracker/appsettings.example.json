{
  // Шаблон конфигурации. Скопируйте этот файл в appsettings.json и appsettings.Development.json
  // и подставьте свои значения: оба этих файла в .gitignore, поэтому секреты не попадут в репозиторий.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Строка подключения к PostgreSQL. Порт и пароль — как у вашего локального сервера.
    "DefaultConnection": "Host=localhost;Port=5434;Database=tasktracker;Username=postgres;Password=CHANGE_ME"
  },
  "Identity": {
    // Кто выдал токен — адрес, на котором слушает API
    "TokenIssuer": "http://localhost:44336",
    // Кому выдан токен — origin фронтенда. Это же значение используется в CORS-политике прода
    "TokenAudience": "http://localhost:4200",
    // Ключ подписи JWT (HMAC-SHA256). ВАЖНО: минимум 32 символа, иначе выпуск токена
    // падает с ошибкой IDX10653 и вход в систему работать не будет.
    "TokenSecret": "CHANGE_ME_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS"
  },
  "TelegramSettings": {
    // Необязательно: telegram id админов через запятую и токен бота для уведомлений о сбоях.
    // Секция должна присутствовать даже с пустыми значениями.
    "AdminTelegramIds": "",
    "TelegramBotToken": ""
  },
  "Security": {
    // Секрет служебных эндпоинтов api/sos/* (выдача ролей вручную)
    "AnonymousTokenRequest": "CHANGE_ME_RANDOM_SERVICE_TOKEN"
  },
  "Database": {
    // Применять миграции обоих контекстов при старте приложения
    "ApplyMigrations": true
  }
}
