# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не должен попадать в git (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=tasktracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5434

# --- API ---
API_PORT=8080
IDENTITY_TOKEN_ISSUER=http://localhost:8080
IDENTITY_TOKEN_AUDIENCE=http://localhost:4200
# Ключ подписи JWT (HMAC-SHA256): минимум 32 символа, иначе вход падает с ошибкой IDX10653
IDENTITY_TOKEN_SECRET=changeme-ultra-mega-long-random-secret
TELEGRAM_ADMIN_IDS=
TELEGRAM_BOT_TOKEN=
SECURITY_ANONYMOUS_TOKEN_REQUEST=changeme

# --- UI ---
UI_PORT=4200
